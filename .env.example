# Docker Compose + app config — copy to .env and fill secrets
#   cp .env.example .env
# On Dokploy, set these in the stack's Environment tab instead of committing them.

PROJECT_NAME=LedgerDesk
VERSION=0.1.0
API_V1_STR=/api/v1
PRODUCTION=True

# Postgres
POSTGRES_USER=ledgerdesk_app
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ledgerdesk
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
# Host port for external DB clients. Change if 5432 is taken on the server.
POSTGRES_PUBLISH_PORT=5432

# Backend security
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_me_generate_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend (baked at image build time — rebuild frontend after changing)
# Must be the publicly reachable API URL, e.g. https://api.example.com/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Only used by compose.local.yaml (host ports for local runs)
BACKEND_PUBLISH_PORT=8000
FRONTEND_PUBLISH_PORT=80
