PROJECT_NAME="LedgerDesk"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Set True in production to disable /docs, /redoc, and OpenAPI schema
PRODUCTION=False

# DATABASE
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change_me_strong_password"
POSTGRES_SERVER="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="ledgerdesk"

# SECURITY
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="change_me_generate_a_long_random_secret"
ALGORITHM="HS256"
# Dev often uses 10080 (7 days). Prefer 60–1440 in production.
ACCESS_TOKEN_EXPIRE_MINUTES="10080"
